# ===== Exemplo de variáveis de ambiente =====
# Copie este arquivo para ".env" (local) ou configure no painel do Render.

# String de conexão do PostgreSQL (Render/Neon te dão isso pronto)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Segredo do JWT — use uma frase longa e aleatória
JWT_SECRET=troque-por-uma-frase-bem-longa-e-aleatoria

# Domínio do frontend (Vercel) que pode chamar a API. Separe por vírgula se tiver mais de um.
CORS_ORIGIN=https://seu-site.vercel.app

# Conta do ADM Master (criada automaticamente na primeira vez que o servidor sobe)
MASTER_NOME=Wendel
MASTER_CPF=00000000000
MASTER_SENHA=suaSenhaForte123

# Porta (o Render define sozinho; em local pode deixar 3000)
PORT=3000
